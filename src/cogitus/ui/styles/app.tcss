/* Cogitus main application styles */

MainScreen {
    layout: horizontal;
}

CogitusStatusBar {
    dock: bottom;
    height: 1;
    layout: horizontal;
    background: $footer-background;
    color: $footer-foreground;
}

CogitusStatusBar > Footer {
    dock: none;
    width: 1fr;
    height: 1;
}

CogitusStatusBar > #footer-cache-warning,
CogitusStatusBar > #footer-command-palette {
    width: auto;
    height: 1;
    margin: 0;
}

CogitusStatusBar > #footer-cache-warning {
    border-left: vkey $foreground 20%;
}

CogitusStatusBar > #footer-cache-warning .footer-key--description {
    padding: 0 1;
    background: $error;
    color: $text;
    text-style: bold;
}

CogitusStatusBar > #footer-cache-warning .footer-key--key {
    padding: 0;
    color: $error;
    background: $error;
}

CogitusStatusBar > #footer-command-palette {
    border-left: vkey $foreground 20%;
}

#idea-list-panel {
    width: 1fr;
    max-width: 45;
    min-width: 30;
    border-right: tall $accent;
}

#idea-list-panel.collapsed {
    display: none;
}

#content-panel {
    width: 3fr;
}

#search-input {
    dock: top;
    height: 3;
    margin: 0;
    padding: 0 1;
    border: solid $border-blurred;
}

#search-input:focus {
    border: solid $border;
}

#search-input.search-active {
    border: solid $warning;
}

#search-input.search-active:focus {
    border: solid $border;
}

#search-autocomplete {
    overlay: screen;
    width: 1fr;
    height: auto;
    max-height: 8;
    constrain: none inside;
    margin: 0;
}

#search-autocomplete.-hidden {
    display: none;
}

#idea-list {
    height: 1fr;
    padding: 1 1 0 1;
}

#idea-list.-hidden,
#search-results.-hidden {
    display: none;
}

#idea-list.search-active:focus > .tree--cursor {
    color: $text;
    background: $warning;
    text-style: bold;
}

#idea-list.search-active > .tree--guides-selected {
    color: $warning;
}

#search-results {
    height: 1fr;
    padding: 0 1 0 1;
    background: $surface;
}

#search-results.search-active:focus {
    border: tall $warning;
}

#search-results > .option-list--option-disabled {
    color: $text-muted;
    background: $panel;
    text-style: bold;
}

#search-results > .option-list--option-highlighted {
    background: $warning;
    color: $text;
}

.idea-tags {
    color: $success;
}

#idea-view-container {
    height: 1fr;
    padding: 1 2;
    background: $surface;
}

#content-panel:focus-within #idea-view-header,
#content-panel:focus-within #idea-view-container,
#content-panel:focus-within #idea-view-body {
    background-tint: $foreground 5%;
}

#idea-view-header {
    dock: top;
    height: auto;
    padding: 1 2;
    background: $surface;
    border-bottom: tall $accent;
}

#idea-view-title {
    text-style: bold;
    width: 100%;
}

#idea-view-tags {
    color: $success;
    margin-top: 1;
}

#idea-view-timestamps {
    color: $text-muted;
}

#idea-view-body {
    padding: 1 2;
    height: auto;
    background: $surface;
}

#empty-state {
    width: 100%;
    height: 100%;
    content-align: center middle;
    color: $text-muted;
}

/* Form screen styles */
IdeaFormScreen {
    align: center middle;
}

#idea-form-container {
    width: 80%;
    max-width: 90%;
    height: 85%;
    max-height: 85%;
    border: thick $accent;
    background: $surface;
    padding: 1 2;
}

#form-title {
    text-style: bold;
    width: 100%;
    text-align: center;
    margin-bottom: 1;
}

#title-input {
    margin-bottom: 1;
}

#idea-form-scroll {
    height: 1fr;
}

#body-input {
    min-height: 8;
    margin-bottom: 1;
}

#tags-group-row {
    layout: horizontal;
    width: 100%;
    height: auto;
    margin-bottom: 1;
}

#tags-column,
#group-column {
    width: 1fr;
    height: auto;
}

#tags-column {
    margin-right: 1;
}

#group-column {
    margin-left: 1;
}

#tags-group-row.narrow {
    layout: vertical;
    height: auto;
}

#tags-group-row.narrow #tags-column,
#tags-group-row.narrow #group-column {
    width: 100%;
    margin: 0;
}

#tags-input {
    margin-bottom: 0;
}

#tags-autocomplete {
    overlay: screen;
    width: 1fr;
    height: auto;
    max-height: 8;
    constrain: none inside;
    margin-top: 0;
}

#tags-autocomplete.-hidden {
    display: none;
}

#group-select {
    margin-bottom: 0;
}

#group-name-input {
    margin-bottom: 1;
}

#name-input {
    margin-bottom: 1;
}

#move-group-select {
    margin-bottom: 1;
}

#form-buttons {
    height: 3;
    align: center middle;
}

#form-buttons Button {
    min-width: 0;
    padding: 0 1;
    margin: 0 1;
}

/* Group dialogs */
GroupFormScreen,
GroupDeleteReassignScreen {
    align: center middle;
}

BackendConfigScreen {
    align: center middle;
}

/* Delete confirmation */
ConfirmDialog {
    align: center middle;
}

RemoteStartupRecoveryScreen {
    align: center middle;
}

RemoteCloneProgressScreen {
    align: center middle;
}

RemoteCloneSwitchModeScreen {
    align: center middle;
}

#confirm-container {
    width: 50;
    height: auto;
    border: thick $error;
    background: $surface;
    padding: 1 2;
}

#confirm-message {
    width: 100%;
    text-align: center;
    margin-bottom: 1;
}

#confirm-buttons {
    height: 3;
    align: center middle;
}

#confirm-buttons Button {
    min-width: 0;
    padding: 0 1;
    margin: 0 1;
}

#remote-startup-container {
    width: 74;
    max-width: 90%;
    height: auto;
    border: thick $error;
    background: $surface;
    padding: 1 2;
}

#remote-startup-message {
    width: 100%;
    text-align: center;
    margin-bottom: 1;
}

#remote-startup-buttons {
    height: 3;
    align: center middle;
}

#remote-startup-buttons Button {
    min-width: 0;
    padding: 0 1;
    margin: 0 1;
}

#remote-clone-container {
    width: 58;
    max-width: 90%;
    height: auto;
    border: thick $accent;
    background: $surface;
    padding: 1 2;
}

#remote-clone-status {
    width: 100%;
    text-align: center;
    margin-bottom: 1;
}

#remote-clone-switch-container {
    width: 58;
    max-width: 90%;
    height: auto;
    border: thick $accent;
    background: $surface;
    padding: 1 2;
}

#remote-clone-switch-message {
    width: 100%;
    text-align: center;
    margin-bottom: 1;
}

#remote-clone-switch-buttons {
    height: 3;
    align: center middle;
}

#remote-clone-switch-buttons Button {
    min-width: 0;
    padding: 0 1;
    margin: 0 1;
}

#name-input-container {
    width: 50;
    height: auto;
    border: thick $accent;
    background: $surface;
    padding: 1 2;
}

#name-input-buttons {
    height: 3;
    align: center middle;
}

#name-input-buttons Button {
    min-width: 0;
    padding: 0 1;
    margin: 0 1;
}

#backend-config-container {
    width: 72;
    max-width: 90%;
    height: auto;
    max-height: 90vh;
    border: thick $accent;
    background: $surface;
    padding: 1 2;
}

#backend-config-container > Label {
    width: 100%;
    margin: 0;
}

#backend-mode-select,
#backend-api-url,
#backend-api-username,
#backend-api-password {
    width: 100%;
}

/* Help overlay */
HelpScreen {
    align: center middle;
}

#help-container {
    width: 60;
    height: auto;
    max-height: 80%;
    border: thick $accent;
    background: $surface;
    padding: 1 2;
}

#help-title {
    text-style: bold;
    width: 100%;
    text-align: center;
    margin-bottom: 1;
}

#help-content {
    height: 1fr;
    min-height: 1;
    scrollbar-gutter: stable;
    scrollbar-size-vertical: 1;
}

#help-body {
    width: 100%;
    padding-right: 1;
}

/* About overlay */
AboutScreen {
    align: center middle;
}

#about-container {
    width: 72;
    height: auto;
    max-height: 80%;
    border: thick $accent;
    background: $surface;
    padding: 1 2;
}

#about-title {
    text-style: bold;
    width: 100%;
    text-align: center;
}

#about-separator {
    color: $text-muted;
    margin: 0 2 1 2;
}

#about-summary {
    width: 100%;
    text-align: center;
    text-style: italic;
    color: $text-muted;
    margin-bottom: 1;
}

#about-content-scroll {
    height: auto;
}

#about-metadata {
    width: 100%;
    height: auto;
}
