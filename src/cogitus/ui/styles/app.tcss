/* Cogitus main application styles */

MainScreen {
    layout: horizontal;
}

#idea-list-panel {
    width: 1fr;
    max-width: 45;
    min-width: 30;
    border-right: tall $accent;
}

#idea-list-panel.collapsed {
    display: none;
}

#content-panel {
    width: 3fr;
}

#search-input {
    dock: top;
    height: 3;
    margin: 0;
    padding: 0 1;
}

#idea-list {
    height: 1fr;
}

.idea-tags {
    color: $success;
}

#idea-view-container {
    height: 1fr;
    padding: 1 2;
}

#idea-view-header {
    dock: top;
    height: auto;
    padding: 1 2;
    background: $surface;
    border-bottom: tall $accent;
}

#idea-view-title {
    text-style: bold;
    width: 100%;
}

#idea-view-tags {
    color: $success;
    margin-top: 1;
}

#idea-view-timestamps {
    color: $text-muted;
}

#idea-view-body {
    padding: 1 2;
    height: auto;
}

#empty-state {
    width: 100%;
    height: 100%;
    content-align: center middle;
    color: $text-muted;
}

/* Form screen styles */
IdeaFormScreen {
    align: center middle;
}

#idea-form-container {
    width: 80%;
    max-width: 90%;
    height: 85%;
    max-height: 85%;
    border: thick $accent;
    background: $surface;
    padding: 1 2;
}

#form-title {
    text-style: bold;
    width: 100%;
    text-align: center;
    margin-bottom: 1;
}

#title-input {
    margin-bottom: 1;
}

#idea-form-scroll {
    height: 1fr;
}

#body-input {
    min-height: 8;
    margin-bottom: 1;
}

#tags-input {
    margin-bottom: 1;
}

#group-select {
    margin-bottom: 1;
}

#form-buttons {
    height: 3;
    align: center middle;
}

#form-buttons Button {
    margin: 0 1;
}

/* Delete confirmation */
ConfirmDialog {
    align: center middle;
}

#confirm-container {
    width: 50;
    height: auto;
    border: thick $error;
    background: $surface;
    padding: 1 2;
}

#confirm-message {
    width: 100%;
    text-align: center;
    margin-bottom: 1;
}

#confirm-buttons {
    height: 3;
    align: center middle;
}

#confirm-buttons Button {
    margin: 0 1;
}

/* Help overlay */
HelpScreen {
    align: center middle;
}

#help-container {
    width: 60;
    height: auto;
    max-height: 80%;
    border: thick $accent;
    background: $surface;
    padding: 1 2;
}

#help-title {
    text-style: bold;
    width: 100%;
    text-align: center;
    margin-bottom: 1;
}

#help-content {
    height: auto;
}
