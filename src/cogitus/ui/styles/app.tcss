/* Cogitus main application styles */

MainScreen {
    layout: horizontal;
}

#idea-list-panel {
    width: 1fr;
    max-width: 45;
    min-width: 30;
    border-right: tall $accent;
}

#idea-list-panel.collapsed {
    display: none;
}

#content-panel {
    width: 3fr;
}

#search-input {
    dock: top;
    height: 3;
    margin: 0;
    padding: 0 1;
    border: solid $border-blurred;
}

#search-input:focus {
    border: solid $border;
}

#search-input.search-active {
    border: solid $warning;
}

#search-autocomplete {
    overlay: screen;
    width: 1fr;
    height: auto;
    max-height: 8;
    constrain: none inside;
    margin: 0;
}

#search-autocomplete.-hidden {
    display: none;
}

#idea-list {
    height: 1fr;
    padding: 1 1 0 1;
}

#idea-list.-hidden,
#search-results.-hidden {
    display: none;
}

#idea-list.search-active:focus > .tree--cursor {
    color: $text;
    background: $warning;
    text-style: bold;
}

#idea-list.search-active > .tree--guides-selected {
    color: $warning;
}

#search-results {
    height: 1fr;
    padding: 0 1 0 1;
    background: $surface;
}

#search-results.search-active:focus {
    border: tall $warning;
}

#search-results > .option-list--option-disabled {
    color: $text-muted;
    background: $panel;
    text-style: bold;
}

#search-results > .option-list--option-highlighted {
    background: $warning;
    color: $text;
}

.idea-tags {
    color: $success;
}

#idea-view-container {
    height: 1fr;
    padding: 1 2;
    background: $surface;
}

#content-panel:focus-within #idea-view-header,
#content-panel:focus-within #idea-view-container,
#content-panel:focus-within #idea-view-body {
    background-tint: $foreground 5%;
}

#idea-view-header {
    dock: top;
    height: auto;
    padding: 1 2;
    background: $surface;
    border-bottom: tall $accent;
}

#idea-view-title {
    text-style: bold;
    width: 100%;
}

#idea-view-tags {
    color: $success;
    margin-top: 1;
}

#idea-view-timestamps {
    color: $text-muted;
}

#idea-view-body {
    padding: 1 2;
    height: auto;
    background: $surface;
}

#empty-state {
    width: 100%;
    height: 100%;
    content-align: center middle;
    color: $text-muted;
}

/* Form screen styles */
IdeaFormScreen {
    align: center middle;
}

#idea-form-container {
    width: 80%;
    max-width: 90%;
    height: 85%;
    max-height: 85%;
    border: thick $accent;
    background: $surface;
    padding: 1 2;
}

#form-title {
    text-style: bold;
    width: 100%;
    text-align: center;
    margin-bottom: 1;
}

#title-input {
    margin-bottom: 1;
}

#idea-form-scroll {
    height: 1fr;
}

#body-input {
    min-height: 8;
    margin-bottom: 1;
}

#tags-group-row {
    layout: horizontal;
    width: 100%;
    height: auto;
    margin-bottom: 1;
}

#tags-column,
#group-column {
    width: 1fr;
    height: auto;
}

#tags-column {
    margin-right: 1;
}

#group-column {
    margin-left: 1;
}

#tags-group-row.narrow {
    layout: vertical;
    height: auto;
}

#tags-group-row.narrow #tags-column,
#tags-group-row.narrow #group-column {
    width: 100%;
    margin: 0;
}

#tags-input {
    margin-bottom: 0;
}

#tags-autocomplete {
    overlay: screen;
    width: 1fr;
    height: auto;
    max-height: 8;
    constrain: none inside;
    margin-top: 0;
}

#tags-autocomplete.-hidden {
    display: none;
}

#group-select {
    margin-bottom: 0;
}

#group-name-input {
    margin-bottom: 1;
}

#name-input {
    margin-bottom: 1;
}

#move-group-select {
    margin-bottom: 1;
}

#form-buttons {
    height: 3;
    align: center middle;
}

#form-buttons Button {
    min-width: 0;
    padding: 0 1;
    margin: 0 1;
}

/* Group dialogs */
GroupFormScreen,
GroupDeleteReassignScreen {
    align: center middle;
}

/* Delete confirmation */
ConfirmDialog {
    align: center middle;
}

#confirm-container {
    width: 50;
    height: auto;
    border: thick $error;
    background: $surface;
    padding: 1 2;
}

#confirm-message {
    width: 100%;
    text-align: center;
    margin-bottom: 1;
}

#confirm-buttons {
    height: 3;
    align: center middle;
}

#confirm-buttons Button {
    min-width: 0;
    padding: 0 1;
    margin: 0 1;
}

#name-input-container {
    width: 50;
    height: auto;
    border: thick $accent;
    background: $surface;
    padding: 1 2;
}

#name-input-buttons {
    height: 3;
    align: center middle;
}

#name-input-buttons Button {
    min-width: 0;
    padding: 0 1;
    margin: 0 1;
}

/* Help overlay */
HelpScreen {
    align: center middle;
}

#help-container {
    width: 60;
    height: auto;
    max-height: 80%;
    border: thick $accent;
    background: $surface;
    padding: 1 2;
}

#help-title {
    text-style: bold;
    width: 100%;
    text-align: center;
    margin-bottom: 1;
}

#help-content {
    height: auto;
}
